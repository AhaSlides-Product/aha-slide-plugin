{
  "name": "aha-slide-plugin",
  "version": "1.0.0",
  "packageManager": "npm@10.9.2",
  "private": true,
  "workspaces": [
    "apps/*/*",
    "packages/*",
    "domains/*",
    "tests"
  ],
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "build:report": "turbo run build --filter=aha-report --filter=@aha/ui",
    "clean": "turbo run clean && rm -rf .turbo node_modules/.cache",
    "test": "turbo run test",
    "docs": "turbo run docs",
    "test:e2e": "cd tests && npx playwright test",
    "test:e2e:ui": "cd tests && npx playwright test --ui",
    "test:e2e:debug": "cd tests && npx playwright test --debug",
    "test:e2e:report": "cd tests && npx playwright show-report",
    "test:consumer": "cd tests && npm run test:consumer",
    "test:consumer:watch": "cd tests && npm run test:consumer:watch",
    "test:consumer:coverage": "cd tests && npm run test:consumer:coverage",
    "storybook": "turbo run storybook"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "description": "",
  "devDependencies": {
    "turbo": "2.7.4",
    "typedoc": "0.28.15",
    "typedoc-plugin-markdown": "4.9.0",
    "vite": "7.3.1"
  }
}