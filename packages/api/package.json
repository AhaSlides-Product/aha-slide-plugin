{
  "name": "@aha/api",
  "version": "1.0.3",
  "description": "Shared utilities for both backend and frontend",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "generate-slide-type-enum": "node scripts/generate-slide-type-enum.js",
    "build": "npm run generate-slide-type-enum && tsc -p tsconfig.json",
    "clean": "rm -rf dist *.tsbuildinfo",
    "docs": "typedoc --skipErrorChecking --plugin typedoc-plugin-markdown --out docs src/index.ts"
  },
  "dependencies": {
    "@aha/common": "*"
  },
  "devDependencies": {
    "typescript": "^5.0.0"
  }
}