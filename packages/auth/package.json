{
  "name": "@aha/auth",
  "version": "0.1.0",
  "description": "Framework-agnostic popup sign-in orchestration for AhaSlides apps \u2014 opens the platform login in a popup, learns when it finished, and never touches a credential.",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "test": "tsc -p tsconfig.json --noEmit && vitest run",
    "test:watch": "vitest watch",
    "clean": "rm -rf dist *.tsbuildinfo",
    "docs": "typedoc --skipErrorChecking --plugin typedoc-plugin-markdown --out docs src/index.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "devDependencies": {
    "typescript": "^5.0.0"
  }
}
