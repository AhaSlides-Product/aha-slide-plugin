{
  "name": "@aha/ui-vanilla",
  "version": "1.5.0",
  "description": "Framework-agnostic TypeScript primitives for AhaSlides slide plugins — zoid contracts, sync stores, image upload, auth.",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "dependencies": {
    "zoid": "^9.0.86"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && echo \"@aha/ui-vanilla: just run type check\"",
    "clean": "rm -rf dist *.tsbuildinfo",
    "docs": "typedoc --skipErrorChecking --plugin typedoc-plugin-markdown --out docs src/index.ts"
  },
  "devDependencies": {
    "typescript": "^5.0.0"
  }
}
