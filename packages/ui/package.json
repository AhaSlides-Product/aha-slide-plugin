{
  "name": "@aha/ui",
  "version": "1.0.9",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./tailwind.config": {
      "import": "./tailwind.config.js",
      "default": "./tailwind.config.js"
    },
    "./ahaslides-vars.css": "./dist/assets/ahaslides-vars.css",
    "./ahaslides-antd-extensions.css": "./dist/assets/ahaslides-antd-extensions.css",
    "./vite.config.icon": {
      "types": "./src/vite.config.icon.d.ts",
      "import": "./src/vite.config.icon.js",
      "default": "./src/vite.config.icon.js"
    },
    "./AhaIcon.vue": "./src/AhaIcon.vue"
  },
  "files": [
    "dist",
    "src/styles.css",
    "src/vite.config.icon.js",
    "src/icons",
    "src/AhaIcon.vue",
    "tailwind.config.js",
    "tailwind.config.d.ts"
  ],
  "scripts": {
    "build": "npm run build:ts && npm run build:antd-css-vars && npm run build:css",
    "clean": "rm -rf dist *.tsbuildinfo",
    "build:icons": "node scripts/generate-icons.js",
    "build:ts": "tsc",
    "build:css": "postcss src/ahaslides-antd-extensions.css -o dist/assets/ahaslides-antd-extensions.css",
    "build:antd-css-vars": "node scripts/generate-css-vars.js",
    "docs": "typedoc --skipErrorChecking --plugin typedoc-plugin-markdown --out docs src/index.ts",
    "test": "echo \"Error: no test specified\" && exit 1"
  },
  "devDependencies": {
    "@ant-design/icons-vue": "^7.0.0",
    "@tailwindcss/postcss": "^4.1.18",
    "@vueuse/core": "^10.0.0",
    "ant-design-vue": "^4.0.0",
    "autoprefixer": "^10.4.23",
    "postcss": "^8.5.6",
    "postcss-cli": "^11.0.1",
    "tailwindcss": "^4.1.18",
    "typescript": "^5.0.0",
    "unplugin-icons": "^23.0.1",
    "unplugin-vue-components": "^30.0.0",
    "vue": "^3.0.0",
    "vue-router": "^4.0.0"
  },
  "peerDependencies": {
    "@ant-design/icons-vue": "^7.0.0",
    "@vueuse/core": "^10.0.0",
    "ant-design-vue": "^4.0.0",
    "vite": "^7.0.0",
    "vue": "^3.0.0",
    "vue-router": "^4.0.0"
  },
  "dependencies": {
    "@aha/design": "*",
    "@aha/ui-vanilla": "*",
    "zoid": "^9.0.86"
  }
}