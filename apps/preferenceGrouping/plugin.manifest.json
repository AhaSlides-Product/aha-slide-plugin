{
  "$schema": "https://plugins.ahaslides.com/schema/plugin-manifest.schema.json",
  "id": "preference-grouping",
  "name": "Preference-based Grouping",
  "baseUrl": "{{VITE_PUBLIC_BASE_URL}}",
  "staticTabs": [
    { "contentUrl": "/", "context": "editor", "name": "Preference-based Grouping" }
  ],
  "slideTypes": [
    {
      "type": "preferenceGrouping",
      "name": "Preference-based Grouping",
      "desc": "Everyone privately picks up to 3 peers; AhaSlides auto-forms balanced groups that maximise satisfied picks, prioritising mutual choices. Individual picks stay private — only the final groups are shown.",
      "canvasUrl": "/preferenceGrouping/canvas/{slideId}",
      "settingUrl": "/preferenceGrouping/settings/{slideId}",
      "audienceUrl": "/preferenceGrouping/audience/{slideId}",
      "setting": {
        "enableFullScreen": false,
        "enableQuestionTitle": true,
        "enableTimeLimit": true,
        "enableStopSubmitssionSetting": true
      }
    }
  ]
}
